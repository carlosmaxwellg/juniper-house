# Set before building. Use the approved HTTPS origin, with no path or trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain.example

# Cloudflare Pages: production settings = production; preview settings = preview.
# Local or unset environments cannot enable indexing.
SITE_ENV=preview

# Keep false in both environments for the fictional-clinic portfolio.
# Production indexing requires SITE_ENV=production AND explicit true here.
SITE_ALLOW_INDEXING=false
